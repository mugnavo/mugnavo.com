---
/** Opening block for inner pages: a ruled label, a large title, and a short lede beside it. */
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<section class="px-6 pt-10 pb-20 sm:px-10 md:pt-16 md:pb-28">
  <div class="relative border-t border-guide-strong pt-8">
    <span aria-hidden="true" class="absolute -top-px left-0 h-3 w-px bg-gold"></span>
    <p class="text-sm type-narrow tracking-[0.14em] text-dim uppercase">{label}</p>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-20">
      <h1 class="max-w-[16ch] text-[clamp(2.5rem,6vw,5.5rem)] leading-[1.02] font-light type-wide">
        {title}
      </h1>
      <p class="max-w-[38ch] pb-1 leading-relaxed text-chalk/70">
        <slot />
      </p>
    </div>
  </div>
</section>
