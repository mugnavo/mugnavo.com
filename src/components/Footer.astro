---
import Logo from "#/components/Logo.astro";
import { SITE_SOCIALS } from "#/lib/consts.ts";
---

<footer class="mx-6 flex flex-col-reverse gap-6 border-t border-guide py-8 text-sm text-dim sm:mx-10 sm:flex-row sm:items-center sm:justify-between">
  <span class="flex items-center gap-3">
    <Logo class="size-4" />
    &copy; {new Date().getFullYear()} Mugnavo
  </span>
  <div class="flex items-center gap-6">
    {SITE_SOCIALS.map(({ href, label, icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noreferrer"
        title={label}
        class="transition-colors hover:text-chalk"
      >
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path d={icon.path} />
        </svg>
        <span class="sr-only">{label}</span>
      </a>
    ))}
  </div>
</footer>
