---
import { ButtonLink } from "@/components/ui/button-link";

const pathname = Astro.url.pathname;
---

<header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 pt-6 pb-2 lg:px-10">
  <a
    title="Home"
    class={"text-xl transition hover:brightness-150 font-bold" +
      (pathname === "/" ? " pointer-events-none" : "")}
    href="/"
  >
    Mugnavo
  </a>
  <nav class="flex items-center gap-4">
    <ButtonLink
      size="xl"
      variant="ghost"
      className="font-medium"
      linkProps={{
        href: "#services",
        title: "Services",
      }}
    >
      Services
    </ButtonLink>

    <ButtonLink
      size="xl"
      variant="default"
      linkProps={{
        href: "#contact",
        title: "Contact",
      }}
    >
      Get in touch
    </ButtonLink>
  </nav>
</header>
