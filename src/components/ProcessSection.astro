---
const PROCESS = [
  {
    title: "Discover",
    body: "We learn how your business works, who it serves, and what the product needs to do.",
  },
  {
    title: "Design",
    body: "We shape the structure, flows, and look, and review them with you before any code is written.",
  },
  {
    title: "Build",
    body: "We develop it with modern, well-tested tools so it's fast, accessible, and easy to grow.",
  },
  {
    title: "Launch and care",
    body: "We ship it, watch it closely, and keep improving it with you after it's live.",
  },
];
---

<section class="px-6 pb-28 sm:px-10 md:pb-40">
  <h2 class="max-w-[20ch] text-[clamp(1.75rem,3.4vw,3rem)] leading-[1.08] font-light type-wide">
    From the first call to launch, and after.
  </h2>
  <ol class="mt-16 grid gap-px border-t border-guide-strong sm:grid-cols-2 lg:grid-cols-4">
    {PROCESS.map((step, index) => (
      <li class="relative pt-8 pr-8 pb-10">
        {/* Tick on the shared rule marks where each step begins */}
        <span aria-hidden="true" class="absolute -top-px left-0 h-3 w-px bg-gold" />
        <span class="text-[2.75rem] leading-none font-extralight type-narrow text-dim">
          {index + 1}
        </span>
        <h3 class="mt-6 text-xl font-medium type-wide">{step.title}</h3>
        <p class="mt-3 max-w-[32ch] leading-relaxed text-chalk/65">{step.body}</p>
      </li>
    ))}
  </ol>
</section>
