---
import Button from "#/components/Button.astro";
import PageHeader from "#/components/PageHeader.astro";
import BaseLayout from "#/layouts/BaseLayout.astro";
import { SITE_TITLE } from "#/lib/consts.ts";
---

<BaseLayout title={`Page not found – ${SITE_TITLE}`} noindex>
  <PageHeader label="404" title="This page doesn't exist.">
    The link may be old or mistyped. Start from the homepage, or see what we've built.
  </PageHeader>

  <section class="flex flex-wrap gap-3 px-6 pb-28 sm:px-10 md:pb-40">
    <Button href="/" size="2xl">
      Back to home
    </Button>
    <Button href="/work/" variant="outline" size="2xl">
      See our work
    </Button>
  </section>
</BaseLayout>
