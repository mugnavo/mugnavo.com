---
import type { ContactPage, WithContext } from "schema-dts";

import Button from "#/components/Button.astro";
import PageHeader from "#/components/PageHeader.astro";
import BaseLayout from "#/layouts/BaseLayout.astro";
import { SITE_CONTACT_EMAIL, SITE_TITLE, SITE_URL, SITE_WEBSITE_ID } from "#/lib/consts.ts";

const fullTitle = `Contact – ${SITE_TITLE}`;
const description = `Tell ${SITE_TITLE} about your website or app project, your timeline, and where you're stuck. We'll reply by email with next steps.`;
const structuredData: WithContext<ContactPage> = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: fullTitle,
  description,
  url: `${SITE_URL}/contact/`,
  isPartOf: {
    "@id": SITE_WEBSITE_ID,
  },
  mainEntity: {
    "@type": "Organization",
    email: SITE_CONTACT_EMAIL,
  },
};
---

<BaseLayout
  title={fullTitle}
  description={description}
  image="/og/contact.png"
  structuredData={structuredData}
>
  <PageHeader label="Contact" title="Tell us what you're building.">
    Share a little about your project, your timeline, and where you're stuck. We'll reply with next
    steps.
  </PageHeader>

  <section class="px-6 pb-28 sm:px-10 md:pb-40">
    <Button href={`mailto:${SITE_CONTACT_EMAIL}`} size="2xl">
      Email {SITE_CONTACT_EMAIL}
    </Button>
  </section>
</BaseLayout>
