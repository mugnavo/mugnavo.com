---
import type { WebPage, WithContext } from "schema-dts";

import Button from "#/components/Button.astro";
import ContactCta from "#/components/ContactCta.astro";
import MarkDrawing from "#/components/home/MarkDrawing.astro";
import ProcessSection from "#/components/ProcessSection.astro";
import SectionLabel from "#/components/SectionLabel.astro";
import BaseLayout from "#/layouts/BaseLayout.astro";
import { SERVICES, SITE_DESCRIPTION, SITE_TITLE, SITE_URL, SITE_WEBSITE_ID } from "#/lib/consts.ts";
import { formatPostDate, getPostsNewestFirst } from "#/lib/posts.ts";

const structuredData: WithContext<WebPage> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${SITE_TITLE} – Web products, built with care.`,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  isPartOf: {
    "@id": SITE_WEBSITE_ID,
  },
};

const [latestPost] = await getPostsNewestFirst();
---

<BaseLayout structuredData={structuredData}>
  {/* Hero */}
  <section class="relative isolate -mt-(--header-height) flex min-h-svh flex-col overflow-hidden pt-(--header-height)">
    <div class="relative min-h-72 flex-1 px-6 sm:px-10">
      <MarkDrawing />
    </div>

    <div class="hero-copy relative z-10 grid gap-8 px-6 pt-10 pb-10 sm:px-10 sm:pb-12 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-20">
      <h1 class="max-w-[13ch] text-[clamp(2.75rem,6.4vw,7rem)] leading-none font-light type-wide">
        Web products, built with care.
      </h1>
      <div class="flex max-w-[34ch] flex-col gap-6 pb-1">
        <p class="leading-relaxed text-chalk/70">
          A small, developer-led studio in the Philippines designing and building websites and apps
          for growing businesses and startups.
        </p>
        <Button href="/contact/" size="2xl" class="w-fit">
          Start a project
        </Button>
      </div>
    </div>
  </section>

  {/* Showcase */}
  <section class="px-6 pt-20 pb-28 sm:px-10 md:pt-28 md:pb-40">
    <div class="grid border-t border-guide-strong lg:grid-cols-[3fr_2fr]">
      <a
        href="https://krafta.io"
        target="_blank"
        rel="noreferrer"
        class="group relative flex flex-col pt-8 pb-12 lg:pr-12 lg:pb-0"
      >
        <span aria-hidden="true" class="absolute -top-px left-0 h-3 w-px bg-gold"></span>
        <SectionLabel>Recent work</SectionLabel>
        <span class="mt-10 block overflow-hidden border border-guide-strong transition-colors duration-500 group-hover:border-gold">
          <img
            src="/images/work/krafta.webp"
            alt="A feedback request in Krafta moving from open, to planned, to shipped"
            width="2400"
            height="600"
            loading="lazy"
            class="block w-full opacity-90 transition duration-700 group-hover:scale-[1.015] group-hover:opacity-100"
          />
        </span>
        <span class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
          <span class="block text-[clamp(2.75rem,5vw,4.75rem)] leading-[0.8] font-extralight type-wide transition-colors duration-500 group-hover:text-gold">
            Krafta
          </span>
          <span class="block max-w-[56ch] text-[0.9375rem] leading-relaxed text-chalk/65">
            Public feedback boards, roadmaps, and changelogs in one place, so product teams can show
            users what happened to their ideas. Designed and built in-house.
          </span>
        </span>
        {/* Dimension line under the name, carrying the link */}
        <span class="mt-8 flex items-center gap-4 text-dim">
          <span aria-hidden="true" class="h-3 w-px bg-guide-strong"></span>
          <span aria-hidden="true" class="h-px flex-1 bg-guide-strong"></span>
          <span class="text-base type-narrow transition-colors group-hover:text-chalk">
            Visit krafta.io
          </span>
          <span aria-hidden="true" class="h-px flex-1 bg-guide-strong"></span>
          <span aria-hidden="true" class="h-3 w-px bg-guide-strong"></span>
        </span>
      </a>

      {latestPost && (
        <div class="relative flex flex-col border-t border-guide pt-8 lg:border-t-0 lg:border-l lg:pl-12">
          <span aria-hidden="true" class="absolute -top-px left-0 h-3 w-px bg-gold lg:hidden" />
          <SectionLabel>From the blog</SectionLabel>
          <a href={`/blog/${latestPost.id}/`} class="group mt-10 flex flex-col">
            <time
              datetime={latestPost.data.pubDate.toISOString()}
              class="text-sm type-narrow text-dim"
            >
              {formatPostDate(latestPost.data.pubDate)}
            </time>
            <h3 class="mt-4 text-2xl leading-tight font-normal type-wide transition-colors group-hover:text-gold lg:text-[1.75rem]">
              {latestPost.data.title}
            </h3>
            <p class="mt-4 leading-relaxed text-chalk/65">{latestPost.data.description}</p>
            <span class="mt-8 text-sm text-chalk underline decoration-guide-strong underline-offset-6 transition-colors group-hover:decoration-gold">
              Read the post
            </span>
          </a>
          <a
            href="/blog/"
            class="mt-auto pt-12 text-sm text-dim transition-colors hover:text-chalk"
          >
            All posts →
          </a>
        </div>
      )}
    </div>
  </section>

  {/* Services */}
  <section class="px-6 pb-28 sm:px-10 md:pb-40">
    <h2 class="max-w-[20ch] text-[clamp(1.75rem,3.4vw,3rem)] leading-[1.08] font-light type-wide">
      What we build
    </h2>
    <div class="mt-16 grid border-t border-l border-guide sm:grid-cols-2">
      {SERVICES.map((service) => (
        <a
          href="/services/"
          class="group relative isolate aspect-4/5 overflow-hidden border-r border-b border-guide transition-colors hover:bg-chalk/3 sm:aspect-5/4 xl:aspect-auto xl:h-128"
        >
          <div class="relative z-10 p-6 sm:p-8 lg:p-10">
            <h3 class="text-2xl font-normal type-wide lg:text-3xl">{service.title}</h3>
            <p class="mt-4 max-w-[36ch] leading-relaxed text-chalk/65">{service.description}</p>
          </div>
          {/* The mockups are drawn to bleed off the bottom-right edge; their top is transparent */}
          <img
            src={service.imageSrc}
            alt=""
            loading="lazy"
            class="absolute right-0 bottom-0 -z-10 w-[85%] translate-x-3 translate-y-3 opacity-75 grayscale transition duration-500 group-hover:translate-0 group-hover:opacity-100 group-hover:grayscale-0 sm:w-[70%] xl:h-[105%] xl:w-auto"
          />
        </a>
      ))}
    </div>
  </section>

  <ProcessSection />
  <ContactCta />
</BaseLayout>
