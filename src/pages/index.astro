---
import BaseLayout from "@/layouts/base.astro";

import HeroLogo from "@/components/home/HeroLogo.astro";
// import IntroCard from "@/components/home/IntroCard.astro";
import ServicesSection from "@/components/home/ServicesSection.astro";
import Stars from "@/components/home/Stars.astro";
import OurProcess from "@/components/home/OurProcess.astro";

import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";

// TODO
// const introCards = [
//   {
//     title: "Venur",
//     subtitle: "TODO",
//     image: "https://placehold.co/600x300/png",
//     href: "https://github.com/mugnavo",
//   },
//   {
//     title: "Introducing templates",
//     subtitle: "Latest blog post",
//     image: "https://placehold.co/600x300/png",
//     href: "/templates",
//   },
// ];
---

<BaseLayout>
  <section class="flex min-h-128 justify-center">
    <div
      class="mt-24 flex w-full flex-col items-center gap-6 text-center md:items-start md:text-start"
    >
      <h1
        class="animate-hero-load max-w-sm text-4xl leading-snug font-bold sm:max-w-xl sm:text-5xl"
      >
        Modern web products, built with
        <span class="text-primary">care.</span>
      </h1>
      <h2
        class="animate-hero-load text-foreground-muted mb-6 max-w-lg text-base md:max-w-xl md:text-lg"
      >
        Thoughtfully designed and developer-built websites and web apps for growing businesses and
        startups.
      </h2>
      <div class="animate-hero-buttons flex gap-4 duration-75 max-sm:text-sm">
        <a
          href="https://cal.com/mugnavo"
          target="_blank"
          rel="noopener noreferrer"
          title="Book via Cal.com"
          class="bg-foreground text-background hover:bg-foreground/80 inline-flex h-14 items-center justify-center gap-2 rounded-xl pr-4 pl-6 text-lg font-semibold transition-colors duration-300"
        >
          Book a call
          <ArrowUpRight />
        </a>
      </div>
    </div>
    <HeroLogo />
  </section>

  <div class="flex flex-col">
    <!-- <section class="bg-card grid w-full gap-4 rounded-3xl p-4 border border-foreground-muted/5 md:grid-cols-2">
      {introCards.map((intro) => <IntroCard {...intro} />)}
    </section> -->
    <section class="bg-card border-foreground-muted/5 w-full rounded-3xl border p-8">
      <OurProcess />
    </section>
    <section class="flex min-h-270 w-full items-center justify-center">
      <div class="flex w-fit flex-col items-center gap-16">
        <span class="text-center text-2xl font-bold tracking-wide md:text-4xl">
          Building for the future.
        </span>
        <p class="text-foreground/80 max-w-[42ch] text-lg tracking-wide md:text-2xl">
          We're a small, developer-led studio based in the Philippines focused on building reliable,
          modern web products for growing businesses and startups.
          <br /><br />
          Our mission is to push the boundaries of technological innovation by delivering products defined
          by exceptional craft and quality.
        </p>
      </div>
      <Stars />
    </section>
    <ServicesSection />
    <section
      class="relative flex min-h-172 w-full flex-col items-center justify-center gap-16 2xl:min-h-192"
    >
      <div id="contact" class="absolute top-16"></div>
      <div class="flex flex-col items-center gap-2 text-center">
        <span class="text-foreground/80 text-xl sm:text-3xl">
          Got a project
          <span class="text-primary drop-shadow-[0_0_24px_rgba(245,220,120,0.8)]"> idea </span>
          in mind?
        </span>
        <span class="text-3xl font-bold sm:text-5xl">Let's get in touch!</span>
      </div>
      <div class="space-y-4">
        <a
          href="https://cal.com/mugnavo"
          target="_blank"
          rel="noopener noreferrer"
          title="Book via Cal.com"
          class="bg-foreground text-background hover:bg-foreground/80 inline-flex h-14 items-center justify-center gap-2 rounded-xl pr-4 pl-6 text-lg font-semibold transition-colors duration-300"
        >
          Book a call
          <ArrowUpRight />
        </a>
        <div class="flex flex-col items-center gap-1">
          <span class="text-foreground-muted text-xs">Or reach out at:</span>
          <a
            href="mailto:hello@mugnavo.com"
            class="text-foreground text-sm font-medium hover:underline"
          >
            hello@mugnavo.com
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
