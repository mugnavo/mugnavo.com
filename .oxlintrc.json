{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y"],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "rules": {
    "no-deprecated": "warn",
    "typescript/no-floating-promises": "off",
    "typescript/no-misused-spread": "off"
  },
  "ignorePatterns": [
    "dist",
    ".wrangler",
    ".vercel",
    ".netlify",
    ".output",
    "build/",
    "worker-configuration.d.ts",
    "scripts/"
  ]
}
