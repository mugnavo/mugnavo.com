  "servers": {
    "Astro docs": {
      "url": "https://mcp.docs.astro.build/mcp",
      "type": "http"
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://docs.mcp.cloudflare.com/mcp"]
    },
    "shadcn": {
